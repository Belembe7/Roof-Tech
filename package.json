{
  "name": "roof-tech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"pnpm --filter @roof-tech/web dev\" \"pnpm --filter @roof-tech/api dev\"",
    "dev:web": "pnpm --filter @roof-tech/web dev",
    "dev:api": "pnpm --filter @roof-tech/api dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @roof-tech/api prisma:generate",
    "db:migrate": "pnpm --filter @roof-tech/api prisma:migrate",
    "db:seed": "pnpm --filter @roof-tech/api prisma:seed",
    "db:setup": "pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "build": "pnpm -r --if-present build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0"
  }
}
