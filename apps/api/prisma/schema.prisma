generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADVERTISER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AdvertiserType {
  OWNER
  AGENT
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum VerificationType {
  IDENTITY
  LISTING_AUTHORIZATION
}

enum VerificationDocumentType {
  IDENTITY_DOCUMENT
  AUTHORIZATION_DOCUMENT
  OTHER
}

enum PropertyType {
  HOUSE
  APARTMENT
  ROOM
  ANNEX
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum AvailabilityStatus {
  UNCONFIRMED
  AVAILABLE
  UNAVAILABLE
}

enum ReportReason {
  INCORRECT_INFORMATION
  POSSIBLE_FRAUD
  UNAVAILABLE_PROPERTY
  UNAUTHORIZED_LISTING
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  NEEDS_INFORMATION
  RESOLVED
  DISMISSED
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String                @db.VarChar(120)
  email               String                @unique @db.VarChar(254)
  passwordHash        String?               @map("password_hash") @db.VarChar(255)
  phone               String?               @db.VarChar(32)
  role                UserRole              @default(CLIENT)
  status              UserStatus            @default(PENDING)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  advertiserProfile   AdvertiserProfile?
  sessions            Session[]
  verificationReviews VerificationRequest[] @relation("VerificationReviewer")
  reportsFiled        Report[]              @relation("ReportReporter")
  reportsReviewed     Report[]              @relation("ReportReviewer")
  availabilityChecks  AvailabilityCheck[]
  auditLogs           AuditLog[]            @relation("AuditActor")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfToken String    @map("csrf_token") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AdvertiserProfile {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @unique @map("user_id") @db.Uuid
  advertiserType       AdvertiserType        @map("advertiser_type")
  verificationStatus   VerificationStatus    @default(NOT_SUBMITTED) @map("verification_status")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  properties           Property[]
  verificationRequests VerificationRequest[]

  @@index([verificationStatus])
  @@map("advertiser_profiles")
}

model City {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  slug          String         @unique @db.VarChar(100)
  province      String         @db.VarChar(100)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  neighborhoods Neighborhood[]

  @@unique([name, province])
  @@map("cities")
}

model Neighborhood {
  id         String     @id @default(uuid()) @db.Uuid
  cityId     String     @map("city_id") @db.Uuid
  name       String     @db.VarChar(100)
  slug       String     @db.VarChar(100)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  city       City       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  properties Property[]

  @@unique([cityId, slug])
  @@index([cityId, name])
  @@map("neighborhoods")
}

model Property {
  id                 String                 @id @default(uuid()) @db.Uuid
  reference          String                 @unique @db.VarChar(24)
  slug               String                 @unique @db.VarChar(180)
  advertiserId       String                 @map("advertiser_id") @db.Uuid
  neighborhoodId     String                 @map("neighborhood_id") @db.Uuid
  title              String                 @db.VarChar(160)
  description        String                 @db.Text
  propertyType       PropertyType           @map("property_type")
  monthlyRent        Decimal                @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount      Decimal?               @map("deposit_amount") @db.Decimal(12, 2)
  visitFee           Decimal?               @map("visit_fee") @db.Decimal(12, 2)
  otherInitialCost   Decimal?               @map("other_initial_cost") @db.Decimal(12, 2)
  bedrooms           Int                    @db.SmallInt
  bathrooms          Int                    @db.SmallInt
  parkingSpaces      Int                    @default(0) @map("parking_spaces") @db.SmallInt
  areaM2             Decimal?               @map("area_m2") @db.Decimal(8, 2)
  moderationStatus   ModerationStatus       @default(DRAFT) @map("moderation_status")
  moderationNote     String?                @map("moderation_note") @db.VarChar(1000)
  availabilityStatus AvailabilityStatus     @default(UNCONFIRMED) @map("availability_status")
  isDemo             Boolean                @default(false) @map("is_demo")
  publishedAt        DateTime?              @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  advertiser         AdvertiserProfile      @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  neighborhood       Neighborhood           @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)
  images             PropertyImage[]
  features           PropertyFeatureValue[]
  reports            Report[]
  availabilityChecks AvailabilityCheck[]

  @@index([moderationStatus, availabilityStatus, createdAt])
  @@index([neighborhoodId, propertyType, monthlyRent])
  @@index([bedrooms, monthlyRent])
  @@index([isDemo, moderationStatus, availabilityStatus])
  @@map("properties")
}

model PropertyImage {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(2048)
  storageKey   String?  @map("storage_key") @db.VarChar(512)
  altText      String?  @map("alt_text") @db.VarChar(180)
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, displayOrder])
  @@index([propertyId, displayOrder])
  @@map("property_images")
}

model PropertyFeature {
  id         String                 @id @default(uuid()) @db.Uuid
  name       String                 @unique @db.VarChar(100)
  slug       String                 @unique @db.VarChar(100)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  properties PropertyFeatureValue[]

  @@map("property_features")
}

model PropertyFeatureValue {
  propertyId String          @map("property_id") @db.Uuid
  featureId  String          @map("feature_id") @db.Uuid
  value      String?         @db.VarChar(160)
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature    PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([propertyId, featureId])
  @@index([featureId, propertyId])
  @@map("property_feature_values")
}

model VerificationRequest {
  id               String                 @id @default(uuid()) @db.Uuid
  advertiserId     String                 @map("advertiser_id") @db.Uuid
  verificationType VerificationType       @map("verification_type")
  status           VerificationStatus     @default(PENDING)
  reviewNote       String?                @map("review_note") @db.VarChar(1000)
  reviewedById     String?                @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  advertiser       AdvertiserProfile      @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  reviewer         User?                  @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents        VerificationDocument[]

  @@index([status, createdAt])
  @@index([advertiserId, verificationType])
  @@map("verification_requests")
}

model VerificationDocument {
  id                    String                   @id @default(uuid()) @db.Uuid
  verificationRequestId String                   @map("verification_request_id") @db.Uuid
  storageKey            String                   @unique @map("storage_key") @db.VarChar(512)
  documentType          VerificationDocumentType @map("document_type")
  mimeType              String                   @map("mime_type") @db.VarChar(100)
  fileSize              Int                      @map("file_size")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  verificationRequest   VerificationRequest      @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId])
  @@map("verification_documents")
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  propertyId   String       @map("property_id") @db.Uuid
  reporterId   String?      @map("reporter_id") @db.Uuid
  reason       ReportReason
  description  String?      @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  reviewedById String?      @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reporter     User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewer     User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([propertyId, createdAt])
  @@map("reports")
}

model AvailabilityCheck {
  id            String             @id @default(uuid()) @db.Uuid
  propertyId    String             @map("property_id") @db.Uuid
  confirmedById String?            @map("confirmed_by") @db.Uuid
  status        AvailabilityStatus
  checkedAt     DateTime           @default(now()) @map("checked_at") @db.Timestamptz(3)
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  confirmer     User?              @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([propertyId, checkedAt])
  @@map("availability_checks")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(80)
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
