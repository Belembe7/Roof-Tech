{
  "name": "@roof-tech/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin:create": "tsx src/commands/create-admin.ts",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@roof-tech/shared": "workspace:*",
    "argon2": "0.45.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.5",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0"
  }
}
