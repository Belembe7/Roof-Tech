{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @roof-tech/api build && pnpm --filter @roof-tech/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index?__api_path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
